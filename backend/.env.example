# IBM Watson / Granite LLM
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key
IBM_WATSONX_PROJECT_ID=your_project_id
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Discovery (for legal corpus RAG)
IBM_DISCOVERY_API_KEY=your_discovery_api_key
IBM_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
IBM_DISCOVERY_VERSION=2023-03-31
IBM_DISCOVERY_PROJECT_ID=your_discovery_project_id

# App Settings
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads
VECTOR_STORE_DIR=./vector_store

# Redis (optional — for async task queue)
REDIS_URL=redis://localhost:6379/0
